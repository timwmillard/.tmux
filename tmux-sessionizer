#!/usr/bin/env bash

# https://github.com/ThePrimeagen/.dotfiles/blob/master/bin/.local/scripts/tmux-sessionizer

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find \
        ~/rapid \
        ~/rapid/*/.worktrees \
        ~/feewise \
        ~/feewise/*/.worktrees \
        ~/cprogs \
        ~/cprogs/*/.worktrees \
        ~/cprogs/vendor \
        ~/dev \
        ~/dev/*/.worktrees \
        ~/dev/vendor \
        ~/go/src \
        ~/go/src/*/.worktrees \
        ~/go/src/github.com/*/ \
        ~/cgeek \
        ~/.config \
        -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected=$(cd "$selected" && pwd -L) || exit 1
selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

find_existing_session() {
    local selected_path=$1
    local session_name
    local window_index
    local pane_id
    local pane_current_path
    local normalized_pane_path

    while IFS=$'\t' read -r session_name window_index pane_id pane_current_path; do
        [[ -z $session_name || -z $window_index || -z $pane_id || -z $pane_current_path || ! -d $pane_current_path ]] && continue

        normalized_pane_path=$(cd "$pane_current_path" && pwd -L)
        if [[ $normalized_pane_path == "$selected_path" ]]; then
            printf '%s\t%s\t%s\n' "$session_name" "$window_index" "$pane_id"
            return 0
        fi
    done < <(tmux list-panes -a -F "#{session_name}	#{window_index}	#{pane_id}	#{pane_current_path}" 2> /dev/null)

    return 1
}

setup_new_session() {
    local session=$1
    local dir=$2
    tmux new-session -ds "$session" -c "$dir"
    tmux send-keys -t "=$session:0" "nvim ." Enter
    tmux new-window -t "=$session:" -c "$dir"
    tmux select-window -t "=$session:0"
}

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    setup_new_session "$selected_name" "$selected"
    tmux attach-session -t "=$selected_name"
    exit 0
fi

existing_window=""
existing_pane=""
existing_match=$(find_existing_session "$selected")
if [[ -n $existing_match ]]; then
    IFS=$'\t' read -r selected_name existing_window existing_pane <<< "$existing_match"
fi

if ! tmux has-session -t "=$selected_name" 2> /dev/null; then
    setup_new_session "$selected_name" "$selected"
fi

tmux switch-client -t "=$selected_name"
if [[ -n $existing_window ]]; then
    tmux select-window -t "=$selected_name:$existing_window"
fi
if [[ -n $existing_pane ]]; then
    tmux select-pane -t "$existing_pane"
fi
